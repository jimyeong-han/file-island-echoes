{
  "name": "file-island-echoes",
  "description": "Small browser game prototype",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001",
    "test": "vitest run",
    "art": "node scripts/export-art.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "art:ui": "node scripts/export-icons.mjs",
    "balance": "node scripts/run-balance.mjs",
    "audio:compose": "python scripts/compose-audio.py",
    "audio:audit": "python scripts/audit-audio.py"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
