{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel && npm run check:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
    {"source": "/pwa-build.json", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
    {"source": "/manifest.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]}
  ]
}
